{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.com/schemas/srt-telemetry/golden-incident-manifest-v1alpha1.json",
  "title": "Robotweax SRT telemetry golden incident manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentId",
    "failureClass",
    "topology",
    "direction",
    "providers",
    "transportProfile",
    "faultPlan",
    "provenance",
    "dataset",
    "expectedEvidence",
    "machineExpectations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1alpha1"
    },
    "incidentId": {
      "type": "string",
      "pattern": "^incident-[0-9]{3,}-[a-z0-9-]+$"
    },
    "failureClass": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": ["sender-to-receiver", "receiver-to-sender", "bidirectional"]
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "provider", "version", "revision"],
        "properties": {
          "role": {
            "enum": ["sender", "receiver", "relay-in", "relay-out"]
          },
          "provider": {
            "enum": ["haivision-srt", "robotweax-srt"]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 7
          },
          "buildProfile": {
            "type": "string"
          }
        }
      }
    },
    "transportProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "api", "addressFamily", "encryption", "fec"],
      "properties": {
        "mode": {
          "enum": ["live", "file"]
        },
        "api": {
          "enum": ["message", "stream"]
        },
        "addressFamily": {
          "enum": ["ipv4", "ipv6"]
        },
        "encryption": {
          "type": "string",
          "minLength": 1
        },
        "fec": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        }
      }
    },
    "faultPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "description", "firstActiveSample", "lastActiveSample"],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "firstActiveSample": {
          "type": "integer",
          "minimum": 0
        },
        "lastActiveSample": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "capturedFromProvider",
        "generator",
        "telemetryVersion",
        "description"
      ],
      "properties": {
        "kind": {
          "enum": ["synthetic-contract-fixture", "captured-provider-run"]
        },
        "capturedFromProvider": {
          "type": "boolean"
        },
        "generator": {
          "type": "string",
          "minLength": 1
        },
        "telemetryVersion": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "synthetic-contract-fixture" } }
          },
          "then": {
            "properties": { "capturedFromProvider": { "const": false } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "captured-provider-run" } }
          },
          "then": {
            "properties": { "capturedFromProvider": { "const": true } }
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "samplesFile",
        "sha256",
        "rows",
        "roles",
        "sampleIntervalNano"
      ],
      "properties": {
        "format": {
          "const": "robotweax-srt-telemetry-csv-v1"
        },
        "samplesFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["sender", "receiver", "relay-in", "relay-out"]
          }
        },
        "sampleIntervalNano": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "recordings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "format",
        "flowId",
        "sender",
        "receiver",
        "analysis"
      ],
      "properties": {
        "schemaVersion": { "const": "1alpha1" },
        "format": { "const": "robotweax-srt-telemetry-jsonl-v1" },
        "flowId": { "type": "string", "minLength": 1 },
        "sender": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "records"],
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "records": { "type": "integer", "minimum": 1 }
          }
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "records"],
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "records": { "type": "integer", "minimum": 1 }
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "sha256", "schemaVersion"],
          "properties": {
            "file": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "schemaVersion": { "const": "1alpha1" }
          }
        }
      }
    },
    "expectedEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "machineExpectations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "field", "operator", "sampleRange"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "role": {
            "enum": ["sender", "receiver", "relay-in", "relay-out"]
          },
          "field": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "operator": {
            "enum": ["equals", "equals-field-plus", "greater-than", "unavailable"]
          },
          "comparisonField": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value": {
            "type": "number"
          },
          "sampleRange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["first", "last"],
            "properties": {
              "first": { "type": "integer", "minimum": 0 },
              "last": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "operator": { "const": "equals" } }
            },
            "then": {
              "required": ["value"],
              "not": { "required": ["comparisonField"] }
            }
          },
          {
            "if": {
              "properties": { "operator": { "const": "equals-field-plus" } }
            },
            "then": { "required": ["comparisonField", "value"] }
          },
          {
            "if": {
              "properties": { "operator": { "const": "greater-than" } }
            },
            "then": {
              "required": ["value"],
              "not": { "required": ["comparisonField"] }
            }
          },
          {
            "if": {
              "properties": { "operator": { "const": "unavailable" } }
            },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["comparisonField"] },
                  { "required": ["value"] }
                ]
              }
            }
          }
        ]
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedAt",
        "telemetryRevision",
        "environment",
        "artifacts",
        "faultProxy"
      ],
      "properties": {
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "telemetryRevision": {
          "type": "string",
          "minLength": 7
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "machine",
            "pythonVersion",
            "transport",
            "timingSource"
          ],
          "properties": {
            "platform": { "type": "string", "minLength": 1 },
            "machine": { "type": "string", "minLength": 1 },
            "pythonVersion": { "type": "string", "minLength": 1 },
            "transport": { "const": "ipv4-loopback-udp-proxy" },
            "timingSource": { "const": "orchestrator-logical-one-second" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "peerExecutableSha256", "providerLibrarySha256"],
            "properties": {
              "role": {
                "enum": ["sender", "receiver", "relay-in", "relay-out"]
              },
              "peerExecutableSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "providerLibrarySha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "faultProxy": {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            {
              "required": ["dropEveryOriginalDataPacket"]
            },
            {
              "required": ["burstStartOriginalDataPacket", "burstLengthPackets"]
            }
          ],
          "required": [
            "classification",
            "messagesPerInterval",
            "payloadBytesPerMessage",
            "expectedDropsPerActiveInterval",
            "stages"
          ],
          "properties": {
            "classification": { "type": "string", "minLength": 1 },
            "pattern": {
              "enum": ["constant-every-nth", "contiguous-burst"]
            },
            "messagesPerInterval": { "type": "integer", "minimum": 1 },
            "payloadBytesPerMessage": { "type": "integer", "minimum": 1 },
            "dropEveryOriginalDataPacket": { "type": "integer", "minimum": 2 },
            "burstStartOriginalDataPacket": { "type": "integer", "minimum": 1 },
            "burstLengthPackets": { "type": "integer", "minimum": 1 },
            "expectedDropsPerActiveInterval": { "type": "integer", "minimum": 1 },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sampleIndex",
                  "active",
                  "originalDataPackets",
                  "repeatedDataPackets",
                  "droppedOriginalDataPackets",
                  "forwardedDataPackets",
                  "forwardedControlPackets",
                  "reversePackets"
                ],
                "properties": {
                  "sampleIndex": { "type": "integer", "minimum": 1 },
                  "active": { "type": "boolean" },
                  "originalDataPackets": { "type": "integer", "minimum": 1 },
                  "repeatedDataPackets": { "type": "integer", "minimum": 0 },
                  "droppedOriginalDataPackets": { "type": "integer", "minimum": 0 },
                  "forwardedDataPackets": { "type": "integer", "minimum": 1 },
                  "forwardedControlPackets": { "type": "integer", "minimum": 0 },
                  "reversePackets": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": { "kind": { "const": "captured-provider-run" } }
          }
        }
      },
      "then": { "required": ["capture"] }
    },
    {
      "if": {
        "properties": {
          "provenance": {
            "properties": { "kind": { "const": "synthetic-contract-fixture" } }
          }
        }
      },
      "then": { "not": { "required": ["capture"] } }
    }
  ]
}
