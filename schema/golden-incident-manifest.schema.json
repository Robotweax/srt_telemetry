{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.com/schemas/srt-telemetry/golden-incident-manifest-v1alpha1.json",
  "title": "Robotweax SRT telemetry golden incident manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "incidentId",
    "failureClass",
    "topology",
    "providers",
    "transportProfile",
    "faultPlan",
    "expectedEvidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1alpha1"
    },
    "incidentId": {
      "type": "string",
      "pattern": "^incident-[0-9]{3,}-[a-z0-9-]+$"
    },
    "failureClass": {
      "type": "string",
      "minLength": 1
    },
    "topology": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "provider", "version", "revision"],
        "properties": {
          "role": {
            "enum": ["sender", "receiver", "relay-in", "relay-out"]
          },
          "provider": {
            "enum": ["haivision-srt", "robotweax-srt"]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 7
          },
          "buildProfile": {
            "type": "string"
          }
        }
      }
    },
    "transportProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "api", "addressFamily", "encryption", "fec"],
      "properties": {
        "mode": {
          "enum": ["live", "file"]
        },
        "api": {
          "enum": ["message", "stream"]
        },
        "addressFamily": {
          "enum": ["ipv4", "ipv6"]
        },
        "encryption": {
          "type": "string",
          "minLength": 1
        },
        "fec": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        }
      }
    },
    "faultPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seed", "description"],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expectedEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "payloadDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
