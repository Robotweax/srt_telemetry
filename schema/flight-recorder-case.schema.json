{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.com/schemas/flight-recorder/case-1.0.json",
  "title": "Robotweax Flight Recorder case manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "robotweax-flight-recorder-case"
    },
    "formatVersion": {
      "const": "1.0"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evidenceClass": {
      "enum": [
        "synthetic-fixture",
        "retained-capture",
        "new-experiment"
      ]
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endpointId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "role": {
                  "enum": [
                    "sender",
                    "receiver"
                  ]
                },
                "connectionEpoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65536
                },
                "recording": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^recordings/endpoint-[1-8]\\.jsonl$"
                },
                "clock": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "endpoint-local",
                        "orchestrator-logical",
                        "host-monotonic"
                      ]
                    },
                    "domainId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "mapping": {
                      "enum": [
                        "none",
                        "paired-sample-index",
                        "coordinator-brackets"
                      ]
                    },
                    "uncertaintyNano": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  },
                  "required": [
                    "kind",
                    "domainId",
                    "mapping",
                    "uncertaintyNano"
                  ]
                },
                "configuration": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "profile": {
                      "enum": [
                        "undeclared",
                        "live-message-ipv4-loopback-clear"
                      ]
                    },
                    "receiverTsbpdDelaySeconds": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "payloadBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "samplingNominalHz": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "preRecords": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "postMilliseconds": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "capacityRecordsPerEndpoint": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "messageApi": {
                      "const": true
                    },
                    "senderTsbpdDelaySeconds": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0
                    }
                  },
                  "required": [
                    "profile",
                    "receiverTsbpdDelaySeconds"
                  ]
                },
                "buildProfileSha256": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[0-9a-f]{64}$"
                },
                "build": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "librarySha256",
                    "peerSha256",
                    "publicApiVersionHex"
                  ],
                  "properties": {
                    "librarySha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "peerSha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "minLength": 64,
                      "maxLength": 64
                    },
                    "publicApiVersionHex": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    }
                  }
                },
                "captureWindow": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "preRecordCount",
                    "preOverwrittenCount",
                    "recordCount",
                    "allocatedRecords",
                    "allocatedRecordBytes",
                    "triggerMonotonicNano",
                    "deadlineMonotonicNano",
                    "firstRetainedMonotonicNano",
                    "lastRetainedMonotonicNano",
                    "retainedPreNano",
                    "retainedPostNano",
                    "finishReason"
                  ],
                  "properties": {
                    "preRecordCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "preOverwrittenCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "recordCount": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "allocatedRecords": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "allocatedRecordBytes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "triggerMonotonicNano": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "deadlineMonotonicNano": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "firstRetainedMonotonicNano": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "lastRetainedMonotonicNano": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "retainedPreNano": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "retainedPostNano": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18446744073709551615
                    },
                    "finishReason": {
                      "enum": [
                        "deadline",
                        "capacity",
                        "monotonic-boundary",
                        "connection-ended",
                        "untriggered-end",
                        "open"
                      ]
                    }
                  }
                }
              },
              "required": [
                "endpointId",
                "role",
                "connectionEpoch",
                "recording",
                "clock",
                "configuration",
                "buildProfileSha256"
              ]
            },
            "maxItems": 8,
            "minItems": 1
          }
        },
        "required": [
          "sessionId",
          "endpoints"
        ]
      },
      "maxItems": 8,
      "minItems": 1
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "paired-sample-index",
            "coordinator-brackets"
          ]
        },
        "uncertaintyNano": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "windows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "endpointId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sampleIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "startNano": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "endNano": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              },
              "sampleMonotonicNano": {
                "type": "integer",
                "minimum": 0,
                "maximum": 18446744073709551615
              }
            },
            "required": [
              "endpointId",
              "sampleIndex",
              "startNano",
              "endNano",
              "sampleMonotonicNano"
            ]
          },
          "maxItems": 32768
        }
      },
      "required": [
        "kind",
        "uncertaintyNano"
      ]
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "manual",
              "automatic",
              "session-start",
              "session-end",
              "reconnect",
              "configuration-change",
              "sample-failure",
              "prehistory-overwritten",
              "post-window-truncated",
              "capacity-exhausted",
              "clock-boundary",
              "counter-reset"
            ]
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "connectionEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "sampleIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "timeDomain": {
            "enum": [
              "logical-window",
              "endpoint-local",
              "coordinator"
            ]
          },
          "timeNano": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "deadlineNano": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "coalescedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "required": [
          "kind"
        ]
      },
      "maxItems": 256
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "manual",
              "automatic",
              "session-start",
              "session-end",
              "reconnect",
              "configuration-change",
              "sample-failure",
              "prehistory-overwritten",
              "post-window-truncated",
              "capacity-exhausted",
              "clock-boundary",
              "counter-reset"
            ]
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "connectionEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "sampleIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "timeDomain": {
            "enum": [
              "logical-window",
              "endpoint-local",
              "coordinator"
            ]
          },
          "timeNano": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "deadlineNano": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "coalescedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "required": [
          "kind"
        ]
      },
      "maxItems": 256
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "manual",
              "automatic",
              "session-start",
              "session-end",
              "reconnect",
              "configuration-change",
              "sample-failure",
              "prehistory-overwritten",
              "post-window-truncated",
              "capacity-exhausted",
              "clock-boundary",
              "counter-reset"
            ]
          },
          "endpointId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "connectionEpoch": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "sampleIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "timeDomain": {
            "enum": [
              "logical-window",
              "endpoint-local",
              "coordinator"
            ]
          },
          "timeNano": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "deadlineNano": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "coalescedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          }
        },
        "required": [
          "kind"
        ]
      },
      "maxItems": 256
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "original-recording",
                  "source-manifest",
                  "capture-metadata"
                ]
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "kind",
              "sha256"
            ]
          },
          "maxItems": 16
        },
        "analyzerSha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[0-9a-f]{64}$"
        },
        "integrity": {
          "const": "sha256-content-integrity-not-authenticity"
        }
      },
      "required": [
        "sources",
        "analyzerSha256",
        "integrity"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "private",
            "support"
          ]
        },
        "mediaPayloads": {
          "const": false
        },
        "credentials": {
          "const": false
        }
      },
      "required": [
        "mode",
        "mediaPayloads",
        "credentials"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCaseBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "maxRecordingBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "maxSamplesPerRecording": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "maxRecordings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "maxCaseBytes",
        "maxRecordingBytes",
        "maxSamplesPerRecording",
        "maxRecordings"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^recordings/endpoint-[1-8]\\.jsonl$"
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[0-9a-f]{64}$"
          },
          "kind": {
            "const": "telemetry-jsonl"
          }
        },
        "required": [
          "path",
          "sizeBytes",
          "sha256",
          "kind"
        ]
      },
      "maxItems": 8,
      "minItems": 1
    }
  },
  "required": [
    "format",
    "formatVersion",
    "caseId",
    "evidenceClass",
    "sessions",
    "alignment",
    "triggers",
    "events",
    "gaps",
    "provenance",
    "privacy",
    "budgets",
    "files"
  ]
}
