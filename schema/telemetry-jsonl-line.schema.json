{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robotweax.com/schemas/srt-telemetry/telemetry-jsonl-line-v1alpha1.json",
  "title": "Robotweax SRT telemetry JSONL line",
  "oneOf": [
    { "$ref": "#/$defs/recording" },
    { "$ref": "#/$defs/sample" }
  ],
  "$defs": {
    "provider": {
      "enum": ["unknown", "haivision-srt", "robotweax-srt"]
    },
    "nullableUnsigned": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "nullableNumber": {
      "type": ["number", "null"]
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "flowId",
        "role",
        "configuredProvider",
        "providerVersion",
        "providerRevision",
        "buildProfile",
        "telemetryVersion",
        "recordCount",
        "capacity",
        "overwrittenCount"
      ],
      "properties": {
        "schemaVersion": { "const": "1alpha1" },
        "kind": { "const": "robotweax-srt-telemetry-recording" },
        "streamId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "flowId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "role": { "enum": ["sender", "receiver"] },
        "configuredProvider": { "enum": ["haivision-srt", "robotweax-srt"] },
        "providerVersion": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "providerRevision": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "buildProfile": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "telemetryVersion": { "const": "0.1.0-alpha.0" },
        "recordCount": { "type": "integer", "minimum": 0 },
        "capacity": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "overwrittenCount": { "type": "integer", "minimum": 0 }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "capabilities",
        "available_fields",
        "observed_at_unix_nano",
        "sample_monotonic_nano",
        "sent_packet_total",
        "received_packet_total",
        "unique_sent_packet_total",
        "unique_received_packet_total",
        "sender_loss_packet_total",
        "receiver_loss_packet_total",
        "retransmitted_packet_total",
        "sender_drop_packet_total",
        "receiver_drop_packet_total",
        "receiver_undecryptable_packet_total",
        "sent_wire_byte_total",
        "received_wire_byte_total",
        "unique_sent_wire_byte_total",
        "unique_received_wire_byte_total",
        "retransmitted_wire_byte_total",
        "rtt_seconds",
        "flight_size_packets",
        "flow_window_packets",
        "congestion_window_packets",
        "available_send_buffer_bytes",
        "available_receive_buffer_bytes",
        "send_buffer_bytes",
        "receive_buffer_bytes",
        "send_buffer_seconds",
        "receive_buffer_seconds",
        "sender_tsbpd_delay_seconds",
        "receiver_tsbpd_delay_seconds"
      ],
      "properties": {
        "provider": { "$ref": "#/$defs/provider" },
        "capabilities": { "type": "integer", "minimum": 0 },
        "available_fields": { "type": "integer", "minimum": 0 },
        "observed_at_unix_nano": { "type": "integer", "minimum": 0 },
        "sample_monotonic_nano": { "type": "integer", "minimum": 0 },
        "sent_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "received_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_sent_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_received_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "sender_loss_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "receiver_loss_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "retransmitted_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "sender_drop_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "receiver_drop_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "receiver_undecryptable_packet_total": { "$ref": "#/$defs/nullableUnsigned" },
        "sent_wire_byte_total": { "$ref": "#/$defs/nullableUnsigned" },
        "received_wire_byte_total": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_sent_wire_byte_total": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_received_wire_byte_total": { "$ref": "#/$defs/nullableUnsigned" },
        "retransmitted_wire_byte_total": { "$ref": "#/$defs/nullableUnsigned" },
        "rtt_seconds": { "$ref": "#/$defs/nullableNumber" },
        "flight_size_packets": { "$ref": "#/$defs/nullableUnsigned" },
        "flow_window_packets": { "$ref": "#/$defs/nullableUnsigned" },
        "congestion_window_packets": { "$ref": "#/$defs/nullableUnsigned" },
        "available_send_buffer_bytes": { "$ref": "#/$defs/nullableUnsigned" },
        "available_receive_buffer_bytes": { "$ref": "#/$defs/nullableUnsigned" },
        "send_buffer_bytes": { "$ref": "#/$defs/nullableUnsigned" },
        "receive_buffer_bytes": { "$ref": "#/$defs/nullableUnsigned" },
        "send_buffer_seconds": { "$ref": "#/$defs/nullableNumber" },
        "receive_buffer_seconds": { "$ref": "#/$defs/nullableNumber" },
        "sender_tsbpd_delay_seconds": { "$ref": "#/$defs/nullableNumber" },
        "receiver_tsbpd_delay_seconds": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_flags",
        "interval_nano",
        "available_delta_fields",
        "counter_reset_fields",
        "available_rates",
        "sent_packet_delta",
        "received_packet_delta",
        "unique_sent_packet_delta",
        "unique_received_packet_delta",
        "sender_loss_packet_delta",
        "receiver_loss_packet_delta",
        "retransmitted_packet_delta",
        "sender_drop_packet_delta",
        "receiver_drop_packet_delta",
        "receiver_undecryptable_packet_delta",
        "sent_wire_byte_delta",
        "received_wire_byte_delta",
        "unique_sent_wire_byte_delta",
        "unique_received_wire_byte_delta",
        "retransmitted_wire_byte_delta",
        "sent_wire_bits_per_second",
        "received_wire_bits_per_second",
        "unique_sent_wire_bits_per_second",
        "unique_received_wire_bits_per_second"
      ],
      "properties": {
        "quality_flags": { "type": "integer", "minimum": 0 },
        "interval_nano": { "type": "integer", "minimum": 0 },
        "available_delta_fields": { "type": "integer", "minimum": 0 },
        "counter_reset_fields": { "type": "integer", "minimum": 0 },
        "available_rates": { "type": "integer", "minimum": 0 },
        "sent_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "received_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_sent_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_received_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "sender_loss_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "receiver_loss_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "retransmitted_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "sender_drop_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "receiver_drop_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "receiver_undecryptable_packet_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "sent_wire_byte_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "received_wire_byte_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_sent_wire_byte_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "unique_received_wire_byte_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "retransmitted_wire_byte_delta": { "$ref": "#/$defs/nullableUnsigned" },
        "sent_wire_bits_per_second": { "$ref": "#/$defs/nullableNumber" },
        "received_wire_bits_per_second": { "$ref": "#/$defs/nullableNumber" },
        "unique_sent_wire_bits_per_second": { "$ref": "#/$defs/nullableNumber" },
        "unique_received_wire_bits_per_second": { "$ref": "#/$defs/nullableNumber" }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "streamId", "sampleIndex", "raw", "delta"],
      "properties": {
        "schemaVersion": { "const": "1alpha1" },
        "kind": { "const": "robotweax-srt-telemetry-sample" },
        "streamId": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sampleIndex": { "type": "integer", "minimum": 0 },
        "raw": { "$ref": "#/$defs/raw" },
        "delta": { "$ref": "#/$defs/delta" }
      }
    }
  }
}
