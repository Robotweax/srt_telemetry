          "$ref": "#/$defs/nullableUnsigned"
        },
        "flow_window_packets": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "congestion_window_packets": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "available_send_buffer_bytes": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "available_receive_buffer_bytes": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "send_buffer_bytes": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "receive_buffer_bytes": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "send_buffer_seconds": {
          "$ref": "#/$defs/nullableNumber"
        },
        "receive_buffer_seconds": {
          "$ref": "#/$defs/nullableNumber"
        },
        "sender_tsbpd_delay_seconds": {
          "$ref": "#/$defs/nullableNumber"
        },
        "receiver_tsbpd_delay_seconds": {
          "$ref": "#/$defs/nullableNumber"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality_flags",
        "interval_nano",
        "available_delta_fields",
        "counter_reset_fields",
        "available_rates",
        "sent_packet_delta",
        "received_packet_delta",
        "unique_sent_packet_delta",
        "unique_received_packet_delta",
        "sender_loss_packet_delta",
        "receiver_loss_packet_delta",
        "retransmitted_packet_delta",
        "sender_drop_packet_delta",
        "receiver_drop_packet_delta",
        "receiver_undecryptable_packet_delta",
        "sent_wire_byte_delta",
        "received_wire_byte_delta",
        "unique_sent_wire_byte_delta",
        "unique_received_wire_byte_delta",
        "retransmitted_wire_byte_delta",
        "sent_wire_bits_per_second",
        "received_wire_bits_per_second",
        "unique_sent_wire_bits_per_second",
        "unique_received_wire_bits_per_second"
      ],
      "properties": {
        "quality_flags": {
          "type": "integer",
          "minimum": 0
        },
        "interval_nano": {
          "type": "integer",
          "minimum": 0
        },
        "available_delta_fields": {
          "type": "integer",
          "minimum": 0
        },
        "counter_reset_fields": {
          "type": "integer",
          "minimum": 0
        },
        "available_rates": {
          "type": "integer",
          "minimum": 0
        },
        "sent_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "received_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "unique_sent_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "unique_received_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "sender_loss_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "receiver_loss_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "retransmitted_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "sender_drop_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned",
          "description": "Interval change in sender_drop_packet_total; counts local buffer removals, not proven application payload loss."
        },
        "receiver_drop_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "receiver_undecryptable_packet_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "sent_wire_byte_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "received_wire_byte_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "unique_sent_wire_byte_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "unique_received_wire_byte_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "retransmitted_wire_byte_delta": {
          "$ref": "#/$defs/nullableUnsigned"
        },
        "sent_wire_bits_per_second": {
          "$ref": "#/$defs/nullableNumber"
        },
        "received_wire_bits_per_second": {
          "$ref": "#/$defs/nullableNumber"
        },
        "unique_sent_wire_bits_per_second": {
          "$ref": "#/$defs/nullableNumber"
        },
        "unique_received_wire_bits_per_second": {
          "$ref": "#/$defs/nullableNumber"
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "sampleIndex",
        "raw",
        "delta"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1alpha1"
        },
        "kind": {
          "const": "robotweax-srt-telemetry-sample"
        },
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sampleIndex": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "$ref": "#/$defs/raw"
        },
        "delta": {
          "$ref": "#/$defs/delta"
        }
      }
    },
    "recording2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "flowId",
        "role",
        "configuredProvider",
        "providerVersion",
        "providerRevision",
        "buildProfile",
        "telemetryVersion",
        "recordCount",
        "capacity",
        "overwrittenCount",
        "groupType",
        "groupRow",
        "healthLines",
        "healthCount",
        "healthOverwrittenCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1alpha2"
        },
        "kind": {
          "const": "robotweax-srt-telemetry-recording"
        },
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "flowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "role": {
          "enum": [
            "sender",
            "receiver"
          ]
        },
        "configuredProvider": {
          "enum": [
            "haivision-srt",
            "robotweax-srt"
          ]
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "providerRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "buildProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "telemetryVersion": {
          "const": "0.1.0-alpha.0"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "overwrittenCount": {
          "type": "integer",
          "minimum": 0
        },
        "groupType": {
          "enum": [
            "backup",
            "broadcast",
            "unknown",
            null
          ]
        },
        "groupRow": {
          "enum": [
            "group",
            "member",
            null
          ]
        },
        "healthLines": {
          "type": "boolean"
        },
        "healthCount": {
          "type": "integer",
          "minimum": 0
        },
        "healthOverwrittenCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "groupType": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "groupRow": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "groupRow": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "healthLines": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "healthCount": {
                "const": 0
              },
              "healthOverwrittenCount": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "member": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "state",
        "standby",
        "authority"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "idle",
            "running",
            "broken",
            "unknown"
          ]
        },
        "standby": {
          "type": "boolean"
        },
        "authority": {
          "enum": [
            "active",
            "probe",
            "none",
            null
          ]
        }
      }
    },
    "sample2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "sampleIndex",
        "raw",
        "delta",
        "member"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1alpha2"
        },
        "kind": {
          "const": "robotweax-srt-telemetry-sample"
        },
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sampleIndex": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "$ref": "#/$defs/raw"
        },
        "delta": {
          "$ref": "#/$defs/delta"
        },
        "member": {
          "$ref": "#/$defs/member"
        }
      }
    },
    "recording3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "flowId",
        "role",
        "configuredProvider",
        "providerVersion",
        "providerRevision",
        "buildProfile",
        "telemetryVersion",
        "recordCount",
        "capacity",
        "overwrittenCount",
        "groupType",
        "groupRow",
        "healthLines",
        "healthCount",
        "healthOverwrittenCount",
        "sessionRef",
        "groupId",
        "peerGroupId",
        "pathLabel",
        "connectedAtUnixNano",
        "connectedAtMonotonicNano"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1alpha3"
        },
        "kind": {
          "const": "robotweax-srt-telemetry-recording"
        },
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "flowId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "role": {
          "enum": [
            "sender",
            "receiver"
          ]
        },
        "configuredProvider": {
          "enum": [
            "haivision-srt",
            "robotweax-srt"
          ]
        },
        "providerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "providerRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "buildProfile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "telemetryVersion": {
          "const": "0.1.0-alpha.0"
        },
        "recordCount": {
          "type": "integer",
          "minimum": 0
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "overwrittenCount": {
          "type": "integer",
          "minimum": 0
        },
        "groupType": {
          "enum": [
            "backup",
            "broadcast",
            "unknown",
            null
          ]
        },
        "groupRow": {
          "enum": [
            "group",
            "member",
            null
          ]
        },
        "healthLines": {
          "type": "boolean"
        },
        "healthCount": {
          "type": "integer",
          "minimum": 0
        },
        "healthOverwrittenCount": {
          "type": "integer",
          "minimum": 0
        },
        "sessionRef": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7e]+$",
          "description": "Opaque key both ends of the session agree on, set by the host; readers keep only a digest."
        },
        "groupId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647,
          "description": "This end's group handle (group and member rows)."
        },
        "peerGroupId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 2147483647,
          "description": "The group ID the caller proposed (SRTO_ROBOTWEAX_PEERGROUP), noted on the accepting side: the caller's groupId."
        },
        "pathLabel": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{2}){1,32}$",
          "description": "Member rows: the negotiated path label (SRTO_ROBOTWEAX_PATHID) as lowercase hex, the same on both ends."
        },
        "connectedAtUnixNano": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Start of the first kept sample's connection: its observedAtUnixNano minus its connectionAgeNano."
        },
        "connectedAtMonotonicNano": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "The same instant on the sample monotonic clock."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "groupType": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "groupRow": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "groupRow": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "healthLines": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "healthCount": {
                "const": 0
              },
              "healthOverwrittenCount": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "groupRow": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "groupId": {
                "type": "null"
              },
              "peerGroupId": {
                "type": "null"
              },
              "pathLabel": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "groupRow": {
                "const": "group"
              }
            }
          },
          "then": {
            "properties": {
              "pathLabel": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "connectedAtUnixNano": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "connectedAtMonotonicNano": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "connectedAtMonotonicNano": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "sample3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "sampleIndex",
        "raw",
        "delta",
        "member",
        "connectionAgeNano"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1alpha3"
        },
        "kind": {
          "const": "robotweax-srt-telemetry-sample"
        },
        "streamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "sampleIndex": {
          "type": "integer",
          "minimum": 0
        },
        "raw": {
          "$ref": "#/$defs/raw"
        },
        "delta": {
          "$ref": "#/$defs/delta"
        },
        "member": {
          "$ref": "#/$defs/member"
        },
        "connectionAgeNano": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "SRT's statistics clock (msTimeStamp) at this sample, in nanoseconds: time since the sample's connection started; null while not connected. A group's counts from its first connected member. A decrease marks a new connection."
        }
      }
    },
    "verdict": {
      "enum": [
        "unknown",
        "ok",
        "watch",
        "at_risk",
        "failing"
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "streamId",
        "sampleIndex",
        "observedAtUnixNano",
        "verdict",
        "reason",
        "knob",
        "knobDirection",
        "suggestedValue",
        "capped",
        "uncappedVerdict",
        "standby",
        "usablePaths",
        "expectedPaths",
        "verdictSinceUnixNano",
        "carried"
      ],
      "properties": {
        "schemaVersion": {
          "enum": [
            "1alpha2",
            "1alpha3"
          ]
        },
