# Fails when a public enum is declared without ROBOTWEAX_SRT_TELEMETRY_ENUM_INT
# (see docs/architecture/telemetry-contract.md). Usage:
#   cmake -DHEADER_DIRS="dir1;dir2" -P CheckEnumDeclarations.cmake
set(missing "")
set(count 0)
foreach(dir IN LISTS HEADER_DIRS)
    file(GLOB_RECURSE headers "${dir}/*.h")
    foreach(header IN LISTS headers)
        file(STRINGS "${header}" lines REGEX "typedef[ \t]+enum")
        foreach(line IN LISTS lines)
            math(EXPR count "${count} + 1")
            if(NOT line MATCHES "ROBOTWEAX_SRT_TELEMETRY_ENUM_INT")
                list(APPEND missing "${header}: ${line}")
            endif()
        endforeach()
    endforeach()
endforeach()
if(missing)
    list(JOIN missing "\n  " text)
    message(FATAL_ERROR "Public enums without ROBOTWEAX_SRT_TELEMETRY_ENUM_INT:\n  ${text}")
endif()
if(count EQUAL 0)
    message(FATAL_ERROR "No public enums found; check HEADER_DIRS")
endif()
message(STATUS "${count} public enums declared with ROBOTWEAX_SRT_TELEMETRY_ENUM_INT")
