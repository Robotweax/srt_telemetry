# Generates a C++ source that embeds the built-in web UI in the HTTP library.
# Run as: cmake -DOUTPUT=<file.cpp> -DUI_DIR=<dir> -DFILES=a,b -P EmbedUiAssets.cmake
# Each file becomes a byte array with its URL path, content type and an ETag
# (SHA-256 prefix), so no request path ever reaches the file system.

if(NOT OUTPUT OR NOT UI_DIR OR NOT FILES)
    message(FATAL_ERROR "EmbedUiAssets.cmake needs OUTPUT, UI_DIR and FILES")
endif()

string(REPLACE "," ";" FILES "${FILES}")
set(body "")
set(table "")
set(index 0)
foreach(name IN LISTS FILES)
    set(path "${UI_DIR}/${name}")
    file(READ "${path}" hex HEX)
    file(SHA256 "${path}" digest)
    string(SUBSTRING "${digest}" 0 20 etag)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Wrap long lines (24 bytes per line) to keep compilers and diffs happy.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " bytes "${bytes}")
    if(name MATCHES "\\.html$")
        set(type "text/html; charset=utf-8")
    elseif(name MATCHES "\\.js$")
        set(type "text/javascript; charset=utf-8")
    elseif(name MATCHES "\\.css$")
        set(type "text/css; charset=utf-8")
    elseif(name MATCHES "\\.svg$")
        set(type "image/svg+xml")
    else()
        message(FATAL_ERROR "EmbedUiAssets.cmake: no content type for ${name}")
    endif()
    if(name STREQUAL "index.html")
        set(url "/")
    else()
        set(url "/${name}")
    endif()
    string(APPEND body "const unsigned char asset_${index}[] = {\n    ${bytes}0x00};\n")
    string(APPEND table "    {\"${url}\", \"${type}\", asset_${index}, ${size}u, \"\\\"${etag}\\\"\"},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "/* Generated by cmake/EmbedUiAssets.cmake from server/ui; do not edit. */
#include \"ui_assets.h\"

namespace robotweax_srt_telemetry_http_ui
{
namespace
{
${body}} // namespace

const Asset assets[] = {
${table}};
const std::size_t asset_count = ${index};

} // namespace robotweax_srt_telemetry_http_ui
")

# Rewrite only on change, so unchanged assets do not trigger a rebuild.
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
    if(previous STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUTPUT}" "${content}")
